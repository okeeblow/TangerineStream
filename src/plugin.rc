#include <windows.h>
#include "resources.h"

IDI_TANGERINE ICON "tangerine.ico"

1 VERSIONINFO
FILEVERSION 0,4,2,0
PRODUCTVERSION 0,4,2,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "COOLTRAINER"
            VALUE "FileDescription", "Tangerine Stream Media Library Plugin"
            VALUE "FileVersion", "0.4.2"
            VALUE "InternalName", "ml_tangerinestream"
            VALUE "OriginalFilename", "ml_tangerinestream.dll"
            VALUE "ProductName", "Tangerine Stream"
            VALUE "ProductVersion", "0.4.2"
            VALUE "Comments", "By COOLTRAINER"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_LIBRARY DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "&Back", IDC_BACK, 2, 2, 25, 13
    LTEXT "&Search:", IDC_SEARCH_LABEL, 30, 2, 30, 13, SS_CENTERIMAGE
    EDITTEXT IDC_QUERY, 61, 2, 333, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "&View", IDC_VIEW_MENU, 398, 2, 30, 13
    CONTROL "", IDC_TRACKS, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_AUTOARRANGE | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP, 2, 17, 426, 216
    PUSHBUTTON "Add server...", IDC_ADD_SERVER, 2, 235, 58, 13
    PUSHBUTTON "Open", IDC_OPEN, 2, 235, 30, 13
    PUSHBUTTON "Play", IDC_PLAY, 2, 235, 30, 13
    PUSHBUTTON "Enqueue", IDC_ENQUEUE, 34, 235, 40, 13
    PUSHBUTTON "Cache", IDC_CACHE_MENU, 76, 235, 34, 13
    LTEXT "", IDC_STATUS, 112, 235, 316, 13, SS_CENTERIMAGE | SS_NOPREFIX | SS_ENDELLIPSIS
END

IDD_SERVER DIALOGEX 0, 0, 300, 167
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Tangerine Stream server settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Display name", -1, 8, 11, 80, 12
    EDITTEXT IDC_NAME, 96, 8, 196, 15, ES_AUTOHSCROLL
    LTEXT "Server base URL", -1, 8, 30, 80, 12
    EDITTEXT IDC_URL, 96, 27, 196, 15, ES_AUTOHSCROLL
    LTEXT "Username", -1, 8, 49, 80, 12
    EDITTEXT IDC_USERNAME, 96, 46, 196, 15, ES_AUTOHSCROLL
    LTEXT "Password", -1, 8, 68, 80, 12
    EDITTEXT IDC_PASSWORD, 96, 65, 196, 15, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL "Use Navidrome's native song browser", IDC_NATIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 87, 284, 12
    CONTROL "Automatically keep server favorites offline", IDC_FAVORITES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 103, 284, 12
    LTEXT "Rolling cache across all servers (MiB)", -1, 8, 123, 165, 12
    EDITTEXT IDC_BUDGET, 180, 120, 57, 15, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 183, 145, 52, 15
    PUSHBUTTON "Cancel", IDCANCEL, 240, 145, 52, 15
END
