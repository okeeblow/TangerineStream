#include <windows.h>
#include "resources.h"
#include "tangerine_product.h"

IDI_TANGERINE ICON "tangerine.ico"

1 VERSIONINFO
FILEVERSION TS_VERSION_TUPLE
PRODUCTVERSION TS_VERSION_TUPLE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "COOLTRAINER"
            VALUE "FileDescription", TS_LIBRARY_FILE_DESCRIPTION
            VALUE "FileVersion", TS_VERSION_STRING
            VALUE "InternalName", "ml_tangerinestream"
            VALUE "OriginalFilename", "ml_tangerinestream.dll"
            VALUE "ProductName", TS_PRODUCT_NAME
            VALUE "ProductVersion", TS_VERSION_STRING
            VALUE "Comments", "By COOLTRAINER"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_LIBRARY DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "&Back", IDC_BACK, 2, 2, 25, 13
    LTEXT "&Search:", IDC_SEARCH_LABEL, 30, 2, 30, 13, SS_CENTERIMAGE
    EDITTEXT IDC_QUERY, 61, 2, 333, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<All>", IDC_SOURCE_MENU, 355, 2, 40, 13
    PUSHBUTTON "Name", IDC_SORT_MENU, 360, 2, 50, 13
    PUSHBUTTON "\x2261", IDC_VIEW_OPTIONS, 413, 2, 15, 13
    CONTROL "", IDC_TRACKS, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_AUTOARRANGE | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP, 2, 17, 426, 216
    CONTROL "", IDC_DETAIL_TILES, "SysListView32", LVS_REPORT | LVS_AUTOARRANGE | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP | NOT WS_VISIBLE, 0, 0, 1, 1
    CONTROL "", IDC_RESULTS, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP | NOT WS_VISIBLE, 0, 0, 1, 1
    CONTROL "", IDC_FILTER_FIRST, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP | NOT WS_VISIBLE, 0, 0, 1, 1
    CONTROL "", IDC_FILTER_SECOND, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP | NOT WS_VISIBLE, 0, 0, 1, 1
    CONTROL "", IDC_FILTER_THIRD, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP | NOT WS_VISIBLE, 0, 0, 1, 1
    CONTROL "", IDC_DIVIDER_H, "Static", SS_NOTIFY | NOT WS_VISIBLE, 0, 0, 1, 1
    CONTROL "", IDC_DIVIDER_V, "Static", SS_NOTIFY | NOT WS_VISIBLE, 0, 0, 1, 1
    CTEXT "Browse and play music from your Navidrome or OpenSubsonic server in WACUP.\r\n\r\nTo connect, you'll need your server address, username, and password.", IDC_WELCOME_TEXT, 2, 2, 426, 45, SS_NOPREFIX | NOT WS_VISIBLE
    PUSHBUTTON "&Add server...", IDC_ADD_SERVER, 165, 52, 100, 30, BS_MULTILINE | NOT WS_VISIBLE
    PUSHBUTTON "Open", IDC_OPEN, 2, 235, 30, 13
    PUSHBUTTON "Play", IDC_PLAY, 2, 235, 30, 13
    PUSHBUTTON "Enqueue", IDC_ENQUEUE, 34, 235, 40, 13
    PUSHBUTTON "Cache", IDC_CACHE_MENU, 76, 235, 34, 13
    LTEXT "", IDC_STATUS, 112, 235, 316, 13, SS_CENTERIMAGE | SS_NOPREFIX | SS_ENDELLIPSIS
END

#define VIEW_WIDTH 310
#define VIEW_HEIGHT 193
IDD_VIEW_EDITOR DIALOGEX 0, 0, VIEW_WIDTH, VIEW_HEIGHT
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP | WS_CLIPCHILDREN
CAPTION "Edit View"
FONT 9, "Segoe UI"
BEGIN
END
IDD_VIEW_FORM DIALOGEX 0, 0, VIEW_WIDTH, VIEW_HEIGHT
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT "View preset", -1, 10, 12, 72, 10
    COMBOBOX IDC_PRESET, 85, 9, 214, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTORADIOBUTTON "Simple List View", IDC_SIMPLE, 10, 34, 115, 12, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Album Cover View", IDC_COVERS, 10, 54, 115, 12
    AUTORADIOBUTTON "Filtered View", IDC_FILTERED, 10, 110, 115, 12
    LTEXT "Cover size (pixels)", -1, 163, 54, 74, 12
    COMBOBOX IDC_COVER_SIZE, 240, 51, 59, 105, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Show the album selection results", IDC_ALBUM_RESULTS, 24, 74, 270, 12
    AUTOCHECKBOX "Show results to the right of the album art", IDC_ALBUMS_RIGHT, 35, 90, 264, 12
    COMBOBOX IDC_FIELD_FIRST, 24, 126, 89, 125, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_FIELD_SECOND, 117, 126, 89, 125, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_FIELD_THIRD, 210, 126, 89, 125, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Show results to the right of the filters", IDC_FILTERS_RIGHT, 24, 147, 270, 12
    DEFPUSHBUTTON "Save", IDOK, 193, 169, 51, 15
    PUSHBUTTON "Cancel", IDCANCEL, 249, 169, 50, 15
END

