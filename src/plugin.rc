#include <windows.h>
#include "resources.h"

IDI_TANGERINE ICON "tangerine.ico"

1 VERSIONINFO
FILEVERSION 0,4,3,0
PRODUCTVERSION 0,4,3,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "COOLTRAINER"
            VALUE "FileDescription", "Tangerine Stream Media Library Plugin"
            VALUE "FileVersion", "0.4.3"
            VALUE "InternalName", "ml_tangerinestream"
            VALUE "OriginalFilename", "ml_tangerinestream.dll"
            VALUE "ProductName", "Tangerine Stream"
            VALUE "ProductVersion", "0.4.3"
            VALUE "Comments", "By COOLTRAINER"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_LIBRARY DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "&Back", IDC_BACK, 2, 2, 25, 13
    LTEXT "&Search:", IDC_SEARCH_LABEL, 30, 2, 30, 13, SS_CENTERIMAGE
    EDITTEXT IDC_QUERY, 61, 2, 333, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<All>", IDC_SOURCE_MENU, 355, 2, 40, 13
    PUSHBUTTON "&View", IDC_VIEW_MENU, 398, 2, 30, 13
    CONTROL "", IDC_TRACKS, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_AUTOARRANGE | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP, 2, 17, 426, 216
    PUSHBUTTON "Add server...", IDC_ADD_SERVER, 2, 235, 58, 13
    PUSHBUTTON "Open", IDC_OPEN, 2, 235, 30, 13
    PUSHBUTTON "Play", IDC_PLAY, 2, 235, 30, 13
    PUSHBUTTON "Enqueue", IDC_ENQUEUE, 34, 235, 40, 13
    PUSHBUTTON "Cache", IDC_CACHE_MENU, 76, 235, 34, 13
    LTEXT "", IDC_STATUS, 112, 235, 316, 13, SS_CENTERIMAGE | SS_NOPREFIX | SS_ENDELLIPSIS
END

IDD_SERVER DIALOGEX 0, 0, 416, 191
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Tangerine Stream settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Servers", -1, 7, 7, 103, 10
    CONTROL "", IDC_SERVERS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | LVS_SHOWSELALWAYS | WS_TABSTOP, 7, 20, 103, 111
    PUSHBUTTON "&Add server...", IDC_ADD_SERVER, 7, 134, 72, 15
    CONTROL "&Unify Libraries", IDC_UNIFIED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 7, 153, 103, 13
    LTEXT "Display &name", -1, 124, 10, 80, 12
    EDITTEXT IDC_NAME, 204, 7, 205, 15, ES_AUTOHSCROLL
    LTEXT "Server base URL", -1, 124, 30, 80, 12
    EDITTEXT IDC_URL, 204, 27, 205, 15, ES_AUTOHSCROLL
    LTEXT "Username", -1, 124, 50, 80, 12
    EDITTEXT IDC_USERNAME, 204, 47, 205, 15, ES_AUTOHSCROLL
    LTEXT "Password", -1, 124, 70, 80, 12
    EDITTEXT IDC_PASSWORD, 204, 67, 205, 15, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL "Use Navidrome's native song browser", IDC_NATIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 92, 285, 13
    CONTROL "Automatically keep server favorites offline", IDC_FAVORITES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 124, 109, 285, 13
    LTEXT "Rolling cache across all servers (MiB)", -1, 124, 148, 177, 12
    EDITTEXT IDC_BUDGET, 304, 145, 65, 15, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 301, 170, 52, 15
    PUSHBUTTON "Cancel", IDCANCEL, 357, 170, 52, 15
END
