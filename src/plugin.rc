#include <windows.h>
#include "resources.h"

IDI_TANGERINE ICON "tangerine.ico"

1 VERSIONINFO
FILEVERSION 0,6,5,0
PRODUCTVERSION 0,6,5,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "COOLTRAINER"
            VALUE "FileDescription", "Tangerine Stream Media Library Plugin"
            VALUE "FileVersion", "0.6.5"
            VALUE "InternalName", "ml_tangerinestream"
            VALUE "OriginalFilename", "ml_tangerinestream.dll"
            VALUE "ProductName", "Tangerine Stream"
            VALUE "ProductVersion", "0.6.5"
            VALUE "Comments", "By COOLTRAINER"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_LIBRARY DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "&Back", IDC_BACK, 2, 2, 25, 13
    LTEXT "&Search:", IDC_SEARCH_LABEL, 30, 2, 30, 13, SS_CENTERIMAGE
    EDITTEXT IDC_QUERY, 61, 2, 333, 13, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "<All>", IDC_SOURCE_MENU, 355, 2, 40, 13
    PUSHBUTTON "&View", IDC_VIEW_MENU, 398, 2, 30, 13
    CONTROL "", IDC_TRACKS, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_AUTOARRANGE | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP, 2, 17, 426, 216
    PUSHBUTTON "Add server...", IDC_ADD_SERVER, 2, 235, 58, 13
    PUSHBUTTON "Open", IDC_OPEN, 2, 235, 30, 13
    PUSHBUTTON "Play", IDC_PLAY, 2, 235, 30, 13
    PUSHBUTTON "Enqueue", IDC_ENQUEUE, 34, 235, 40, 13
    PUSHBUTTON "Cache", IDC_CACHE_MENU, 76, 235, 34, 13
    LTEXT "", IDC_STATUS, 112, 235, 316, 13, SS_CENTERIMAGE | SS_NOPREFIX | SS_ENDELLIPSIS
END

#define SETTINGS_WIDTH 402
#define SETTINGS_HEIGHT 261
IDD_SERVER DIALOGEX 0, 0, SETTINGS_WIDTH, SETTINGS_HEIGHT
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP | WS_CLIPCHILDREN
CAPTION "Tangerine Stream settings"
FONT 9, "Segoe UI"
BEGIN
END

IDD_SERVER_FORM DIALOGEX 0, 0, SETTINGS_WIDTH, SETTINGS_HEIGHT
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    LTEXT "&Servers", -1, 10, 10, 98, 10
    CONTROL "", IDC_SERVERS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_NOCOLUMNHEADER | LVS_SHOWSELALWAYS | WS_TABSTOP, 10, 23, 98, 148
    PUSHBUTTON "&Add server...", IDC_ADD_SERVER, 10, 175, 98, 15
    PUSHBUTTON "&Remove server", IDC_REMOVE_SERVER, 10, 194, 98, 15
    CONTROL "&Unify Libraries", IDC_UNIFIED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 216, 98, 10
    LTEXT "Display &name", -1, 123, 13, 76, 10
    EDITTEXT IDC_NAME, 204, 13, 188, 10, ES_AUTOHSCROLL | NOT WS_BORDER
    LTEXT "Server base URL", -1, 123, 33, 76, 10
    EDITTEXT IDC_URL, 204, 33, 188, 10, ES_AUTOHSCROLL | NOT WS_BORDER
    LTEXT "Username", -1, 123, 53, 76, 10
    EDITTEXT IDC_USERNAME, 204, 53, 188, 10, ES_AUTOHSCROLL | NOT WS_BORDER
    LTEXT "Password", -1, 123, 73, 76, 10
    EDITTEXT IDC_PASSWORD, 204, 73, 188, 10, ES_PASSWORD | ES_AUTOHSCROLL | NOT WS_BORDER
    CONTROL "Use Navidrome's native library browser", IDC_NATIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 204, 94, 188, 10
    CONTROL "Automatically keep server favorites offline", IDC_FAVORITES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 204, 109, 188, 10
    LTEXT "Streaming quality", -1, 123, 131, 76, 10
    LTEXT "Format", -1, 204, 131, 98, 10
    LTEXT "Max kbps (0 = server)", -1, 309, 131, 83, 10
    LTEXT "Unmetered", -1, 123, 148, 76, 10
    COMBOBOX IDC_UNMETERED_FORMAT, 204, 147, 98, 94, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_UNMETERED_RATE, 309, 148, 83, 10, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER
    LTEXT "Metered", -1, 123, 168, 76, 10
    COMBOBOX IDC_METERED_FORMAT, 204, 167, 98, 94, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_METERED_RATE, 309, 168, 83, 10, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER
    CONTROL "Upgrade offline favorites to original quality on unmetered connections", IDC_UPGRADE_FAVORITES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 123, 190, 269, 10
    LTEXT "Shared rolling cache", -1, 123, 217, 76, 10
    EDITTEXT IDC_BUDGET, 204, 217, 50, 10, ES_NUMBER | ES_AUTOHSCROLL | NOT WS_BORDER
    LTEXT "MiB", -1, 258, 217, 30, 10
    LTEXT "", IDC_ACCOUNT_NOTE, 10, 234, 265, 21, SS_CENTERIMAGE
    DEFPUSHBUTTON "Save", IDOK, 282, 236, 52, 15
    PUSHBUTTON "Cancel", IDCANCEL, 340, 236, 52, 15
END
