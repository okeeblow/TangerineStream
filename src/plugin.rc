#include <windows.h>
#include "resources.h"

IDI_TANGERINE ICON "tangerine.ico"

1 VERSIONINFO
FILEVERSION 0,3,1,0
PRODUCTVERSION 0,3,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "COOLTRAINER"
            VALUE "FileDescription", "Tangerine Stream Media Library Plugin"
            VALUE "FileVersion", "0.3.1"
            VALUE "InternalName", "ml_tangerinestream"
            VALUE "OriginalFilename", "ml_tangerinestream.dll"
            VALUE "ProductName", "Tangerine Stream"
            VALUE "ProductVersion", "0.3.1"
            VALUE "Comments", "By COOLTRAINER"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDD_LIBRARY DIALOGEX 0, 0, 430, 250
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "Segoe UI"
BEGIN
    COMBOBOX IDC_SERVERS, 4, 4, 268, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Add server...", IDC_ADD_SERVER, 274, 4, 72, 15
    PUSHBUTTON "Settings...", IDC_SETTINGS, 350, 4, 76, 15
    PUSHBUTTON "Back", IDC_BACK, 4, 23, 40, 15
    EDITTEXT IDC_QUERY, 48, 23, 233, 15, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Search", IDC_SEARCH, 285, 23, 52, 15
    CONTROL "Text list", IDC_TEXT_LIST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 343, 23, 82, 15
    CONTROL "Offline", IDC_OFFLINE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 373, 23, 53, 15
    LTEXT "", IDC_LOCATION, 4, 42, 422, 12, SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL "", IDC_TRACKS, "SysListView32", LVS_REPORT | LVS_OWNERDATA | LVS_AUTOARRANGE | LVS_SHAREIMAGELISTS | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 4, 55, 422, 154
    PUSHBUTTON "Open", IDC_OPEN, 4, 213, 36, 15
    PUSHBUTTON "Play", IDC_PLAY, 4, 213, 36, 15
    PUSHBUTTON "Enqueue", IDC_ENQUEUE, 44, 213, 53, 15
    PUSHBUTTON "Keep offline", IDC_KEEP_OFFLINE, 101, 213, 68, 15
    PUSHBUTTON "Unpin", IDC_UNPIN, 173, 213, 39, 15
    LTEXT "", IDC_STATUS, 4, 232, 422, 14, SS_NOPREFIX | SS_ENDELLIPSIS
END

IDD_SERVER DIALOGEX 0, 0, 300, 167
STYLE DS_SETFONT | DS_MODALFRAME | WS_CAPTION | WS_SYSMENU | WS_POPUP
CAPTION "Tangerine Stream server settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Display name", -1, 8, 11, 80, 12
    EDITTEXT IDC_NAME, 96, 8, 196, 15, ES_AUTOHSCROLL
    LTEXT "Server base URL", -1, 8, 30, 80, 12
    EDITTEXT IDC_URL, 96, 27, 196, 15, ES_AUTOHSCROLL
    LTEXT "Username", -1, 8, 49, 80, 12
    EDITTEXT IDC_USERNAME, 96, 46, 196, 15, ES_AUTOHSCROLL
    LTEXT "Password", -1, 8, 68, 80, 12
    EDITTEXT IDC_PASSWORD, 96, 65, 196, 15, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL "Use Navidrome's native song browser", IDC_NATIVE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 87, 284, 12
    CONTROL "Automatically keep server favorites offline", IDC_FAVORITES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 103, 284, 12
    LTEXT "Rolling cache across all servers (MiB)", -1, 8, 123, 165, 12
    EDITTEXT IDC_BUDGET, 180, 120, 57, 15, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 183, 145, 52, 15
    PUSHBUTTON "Cancel", IDCANCEL, 240, 145, 52, 15
END
