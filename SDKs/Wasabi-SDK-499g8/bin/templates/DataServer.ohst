<Ode:HelperStandaloneTemplate classname="*DS" friend="1" inherit="serial" desc="Auto exposure of member data" >

<!-- DataServer template, automatically exposes public data via accessors. -->
<!-- See the data subdirectory for c++template-specific templates -->

<module id="h" filename="*DS.h">

// ----------------------------------------------------------------------------<br/>
// Generated by DataServerFactory [<datetime/>]<br/>
// <br/>
// File        : <moduledata data="filename"/><br/>
// Class       : <class data="classlayer"/><br/>
// class layer : Data Server Class
// ----------------------------------------------------------------------------<br/>
<br/>

<!-- compiler safeguards -->

#ifndef __<class data="classlayer" ucase="1"/>_H<br/>
#define __<class data="classlayer" ucase="1"/>_H<br/>
<br/>

<autoheader/><br/>
<br/>

<!-- custom header codeblocks -->
<foreach objects="codeblocks" type="dataserver.header.h">
  <codeblock data="block"/>
  <br/>
</foreach>

<!-- class declaration -->

// ----------------------------------------------------------------------------<br/>
<br/>
class <class data="classlayer"/><deriveancestor/>
<ob/><br/>
<indent>

  <!--protected constructor -->

  protected:<br/>

  <indent>
    <class data="classlayer"/>();<br/>
    virtual ~<class data="classlayer"/>();<br/>
  </indent>  

  <!-- custom class codeblocks -->

  <foreach objects="codeblocks" type="dataserver">
   <codeblock data="scope"/>
   <indent>
      <codeblock data="block"/>
      <br/>
   </indent>  
  </foreach>

  <br/>
  public:<br/>
  <indent>

   <foreach objects="data">

    <if object="data" isoftype="template" not="1">
     <if object="data" isoftype="class">
      <if object="data" isoftype="pointer" not="1">

       <if object="data" isoftype="aliased" not="1">

        <!-- data is a nonaliased object, expose a pointer to it, read only -->

        //--------------------------------------------------------<br/>
        // Accessor for <data data="type"/><data data="name"/>%20(pointer to member object)<br/>
        //--------------------------------------------------------<br/>
        <helperdatamethods>
          virtual <data data="type"/> *get<data data="name" uclead="1" delprefix="m_"/>(); // Returns a pointer to <data data="name"/><br/>
        </helperdatamethods>

        <else> <!-- isoftype aliased -->

         <!-- data is an aliased object, expose the alias type -->

         //--------------------------------------------------------<br/>
         // Accessors for <data data="type"/><data data="name"/>%20(aliased [<data data="aliastype" delsuffix=" " />] access to member object)<br/>
         //--------------------------------------------------------<br/>
         <helperdatamethods>
           virtual <data data="aliastype"/> get<data data="name" uclead="1" delprefix="m_"/>(); // Returns the value of <data data="name"/> <br/>
           virtual void set<data data="name" uclead="1" delprefix="m_"/>(<data data="aliastype"/> _<data data="name" delprefix="m_"/>); // Changes the value of <data data="name"/> <br/>
           virtual void onSet<data data="name" uclead="1" delprefix="m_"/>(<data data="aliastype"/> _<data data="name" delprefix="m_"/>); // Called when the value of <data data="name"/>%20is changed via a call to set<data data="name" uclead="1" delprefix="m_"/><br/>
         </helperdatamethods>

        </else> 

       </if> <!-- end isoftype aliased -->

       <else> <!-- isoftype pointer -->

        <!-- data is an object pointer, expose it as is, read/write/callback -->

         //--------------------------------------------------------<br/>
         // Accessors for <data data="type"/><data data="name"/>%20(member object pointer)<br/>
         //--------------------------------------------------------<br/>
        <helperdatamethods>
          virtual <data data="type"/> get<data data="name" uclead="1" delprefix="m_"/>();  // Returns the pointer <data data="name"/> <br/>
          virtual void set<data data="name" uclead="1" delprefix="m_"/>(<data data="type"/> _<data data="name" delprefix="m_"/>); // Changes the pointer <data data="name"/> <br/>
          virtual void onSet<data data="name" uclead="1" delprefix="m_"/>(<data data="type"/> _<data data="name" delprefix="m_"/>); // Called when the pointer <data data="name"/>%20is changed via a call to set<data data="name" uclead="1" delprefix="m_"/><br/>
        </helperdatamethods>

       </else>

      </if> <!-- end isoftype pointer -->

      <else> <!-- isoftype class -->

      <!-- data is neither a class nor a template, expose it as is, read/write/callback -->

       //--------------------------------------------------------<br/>
       // Accessors for <data data="type"/><data data="name"/>%20(member variable)<br/>
       //--------------------------------------------------------<br/>
      <helperdatamethods>
        virtual <data data="type"/> get<data data="name" uclead="1" delprefix="m_"/>(); // Returns the value of <data data="name"/> <br/>
        virtual void set<data data="name" uclead="1" delprefix="m_"/>(<data data="type"/> _<data data="name" delprefix="m_"/>); // Changes the value of <data data="name"/> <br/>
        virtual void onSet<data data="name" uclead="1" delprefix="m_"/>(<data data="type"/> _<data data="name" delprefix="m_"/>); // Called when the value of <data data="name"/>%20is changed via a call to set<data data="name" uclead="1" delprefix="m_"/><br/>
      </helperdatamethods>

     </else>

    </if> <!-- end isoftype class -->

    <else>

     <!-- data is a template, expose custom code or nothing -->

     <if object="data" isoftype="templatized">

      <datatemplate module="decl"/> <!-- extracts the template name from the current data and injects that data into it -->

      <else> <!-- isoftype templatized -->

       // Don't know how to export template <data data="type"/> for member <data data="name"/><br/>

      </else>

     </if> <!-- end isoftype templatized -->

    </else>

   </if> <!-- end isoftype template -->
   <br/>
  </foreach>
 </indent>

</indent>
<cb/>;<br/>
<br/>
// ----------------------------------------------------------------------------<br/>
<br/>

<!-- custom footer codeblocks -->
<foreach objects="codeblocks" type="dataserver.footer.h">
  <codeblock data="block"/>
  <br/>
</foreach>

#endif // __<class data="classlayer" ucase="1"/>_H<br/>

</module>

<!-- cpp file -->

<module id="cpp" filename="*DS.cpp">
// ----------------------------------------------------------------------------<br/>
// Generated by DataServerFactory [<datetime/>]<br/>
// <br/>
// File        : <moduledata data="filename"/><br/>
// Class       : <class data="classlayer"/><br/>
// class layer : Data Server Class
// ----------------------------------------------------------------------------<br/>
<stdafx/>
<br/>
#include "<class data="implementationheader"/>"<br/>
#include "<class data="classlayer"/>.h"<br/>
<br/>

#ifdef CASTTHIS<br/>
#undef CASTTHIS<br/>
#endif<br/>
#define CASTTHIS (static_cast%3C<class data="implname"/> *%3E(this))<br/>
<br/>

<!-- custom header codeblocks -->
<foreach objects="codeblocks" type="dataserver.header.cpp">
  <codeblock data="block"/>
  <br/>
</foreach>

//--------------------------------------------------------<br/>
// Data initialization<br/>
//--------------------------------------------------------<br/>
<class data="classlayer"/>::<class data="classlayer"/>() <ob/><br/>
<indent>
 <foreach objects="data">
  <data data="ctorcode"/>
 </foreach>
</indent>
<cb/><br/>
<br/>

//--------------------------------------------------------<br/>
// Data shutdown<br/>
//--------------------------------------------------------<br/>
<class data="classlayer"/>::~<class data="classlayer"/>() <ob/><br/>
<indent>
 <foreach objects="data">
  <data data="dtorcode"/>
 </foreach>
</indent>
<cb/><br/>
<br/>

<foreach objects="data">

 <if object="data" isoftype="template" not="1">
  <if object="data" isoftype="class">
   <if object="data" isoftype="pointer" not="1">

    <if object="data" isoftype="aliased" not="1">

     <!-- data is a nonaliased object, expose a pointer to it, read only -->

     //--------------------------------------------------------<br/>
     // Accessor for <data data="type"/><data data="name"/>%20(pointer to member object)<br/>
     //--------------------------------------------------------<br/>
       <data data="type"/> *<class data="classlayer"/>::get<data data="name" uclead="1" delprefix="m_"/>()<ob/><br/>
       <indent>
         return %26(CASTTHIS-><data data="name"/>);<br/>
       </indent>
       <cb/><br/>

      <else> <!-- isoftype aliased -->

       <!-- data is an aliased object, expose the alias type -->

       //--------------------------------------------------------<br/>
       // Accessors for <data data="type"/><data data="name"/>%20(aliased [<data data="aliastype" delsuffix=" " />] access to member object)<br/>
       //--------------------------------------------------------<br/>
       <br/>
       // Returns the value of <data data="name"/> <br/>
       <data data="aliastype"/> <class data="classlayer"/>::get<data data="name" uclead="1" delprefix="m_"/>() <ob/><br/>
       <indent>
        return CASTTHIS-><data data="name"/>;<br/>
       </indent>
       <cb/><br/>
       <br/>
       // Changes the value of <data data="name"/> <br/>
       void <class data="classlayer"/>::set<data data="name" uclead="1" delprefix="m_"/>(<data data="aliastype"/> _<data data="name" delprefix="m_"/>) <ob/><br/>
       <indent>
        if (CASTTHIS-><data data="name"/>%20== _<data data="name" delprefix="m_"/>) return;<br/>
        CASTTHIS-><data data="name"/>%20= _<data data="name" delprefix="m_"/>;<br/>
        onSet<data data="name" uclead="1" delprefix="m_"/>(_<data data="name" delprefix="m_"/>);<br/>
       </indent>
       <cb/><br/>
       <br/>
       // Called when the value of <data data="name"/>%20is changed via a call to set<data data="name" uclead="1" delprefix="m_"/><br/>
       void <class data="classlayer"/>::onSet<data data="name" uclead="1" delprefix="m_"/>(<data data="aliastype"/> _<data data="name" delprefix="m_"/>) <ob/><br/>
       <cb/><br/>
       <br/>

      </else> 

     </if> <!-- end isoftype aliased -->

     <else> <!-- isoftype pointer -->

      <!-- data is an object pointer, expose it as is, read/write/callback -->

      //--------------------------------------------------------<br/>
      // Accessors for <data data="type"/><data data="name"/>%20(member object pointer)<br/>
      //--------------------------------------------------------<br/>
      <br/>
      // Returns the pointer <data data="name"/> <br/>
      <data data="type"/> <class data="classlayer"/>::get<data data="name" uclead="1" delprefix="m_"/>() <ob/><br/>
      <indent>
       return CASTTHIS-><data data="name"/>;<br/>
      </indent>
      <cb/><br/>
      <br/>
      // Changes the pointer <data data="name"/> <br/>
      void <class data="classlayer"/>::set<data data="name" uclead="1" delprefix="m_"/>(<data data="type"/> _<data data="name" delprefix="m_"/>) <ob/><br/>
      <indent>
       if (CASTTHIS-><data data="name"/>%20== _<data data="name" delprefix="m_"/>) return;<br/>
       CASTTHIS-><data data="name"/>%20= _<data data="name" delprefix="m_"/>;<br/>
       onSet<data data="name" uclead="1" delprefix="m_"/>(_<data data="name" delprefix="m_"/>);<br/>
      </indent>
      <cb/><br/>
      <br/>
      // Called when the pointer <data data="name"/>%20is changed via a call to set<data data="name" uclead="1" delprefix="m_"/><br/>
      void <class data="classlayer"/>::onSet<data data="name" uclead="1" delprefix="m_"/>(<data data="type"/> _<data data="name" delprefix="m_"/>) <ob/><br/>
      <cb/><br/>

     </else>

    </if> <!-- end isoftype pointer -->

    <else> <!-- isoftype class -->

     <!-- data is neither a class nor a template, expose it as is, read/write/callback -->

     //--------------------------------------------------------<br/>
     // Accessors for <data data="type"/><data data="name"/>%20(member variable)<br/>
     //--------------------------------------------------------<br/>
     <br/>
     // Returns the value of <data data="name"/> <br/>
     <data data="type"/> <class data="classlayer"/>::get<data data="name" uclead="1" delprefix="m_"/>() <ob/><br/>
     <indent>
      return CASTTHIS-><data data="name"/>;<br/>
     </indent>
     <cb/><br/>
     <br/>
     // Changes the value of <data data="name"/> <br/>
     void <class data="classlayer"/>::set<data data="name" uclead="1" delprefix="m_"/>(<data data="type"/> _<data data="name" delprefix="m_"/>) <ob/><br/>
     <indent>
      if (CASTTHIS-><data data="name"/>%20== _<data data="name" delprefix="m_"/>) return;<br/>
      CASTTHIS-><data data="name"/>%20= _<data data="name" delprefix="m_"/>;<br/>
      onSet<data data="name" uclead="1" delprefix="m_"/>(_<data data="name" delprefix="m_"/>);<br/>
     </indent>
     <cb/><br/>
     <br/>
     // Called when the value of <data data="name"/>%20is changed via a call to set<data data="name" uclead="1" delprefix="m_"/><br/>
     void <class data="classlayer"/>::onSet<data data="name" uclead="1" delprefix="m_"/>(<data data="type"/> _<data data="name" delprefix="m_"/>) <ob/><br/>
     <cb/><br/>
     <br/>

   </else>

  </if> <!-- end isoftype class -->

  <else>

   <!-- data is a template, expose custom code or nothing -->

   <if object="data" isoftype="templatized">

    <datatemplate module="impl"/> <!-- extracts the template name from the current data and injects that data into it -->

    <else> <!-- isoftype templatized -->

     // Don't know how to export template <data data="type"/> for member <data data="name"/><br/>

    </else>

   </if> <!-- end isoftype templatized -->

  </else>

 </if> <!-- end isoftype template -->

</foreach>

<!-- custom header codeblocks -->
<foreach objects="codeblocks" type="dataserver.footer.cpp">
  <codeblock data="block"/>
  <br/>
</foreach>

</module>

</Ode:HelperStandaloneTemplate>
