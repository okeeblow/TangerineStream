    EDITTEXT        IDC_PASS,57,57,92,14,ES_PASSWORD | ES_AUTOHSCROLL
    RTEXT           "Password:",IDC_STATIC,7,57,41,14,SS_CENTERIMAGE
    DEFPUSHBUTTON   "OK",IDOK,43,84,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,99,84,50,14
END


